include tools.env

default: precommit

precommit: ensure format generate python-check python-test shell-test test check addlicense
	@echo "ready to commit"

# The attention poster is vendored Python, and every other target in this file is Go —
# nothing here parsed `scripts/*.py` before this. Without it a truncated or malformed
# copy ships green: the image builds, CI passes, and the pod fails only when it first
# tries to raise a gate. `ast.parse` rather than `py_compile` so no `__pycache__` is
# written into the tree.
PYTHON_SCRIPTS = $(wildcard scripts/*.py)

# The agent image's shell helpers are `agent/scripts/*.sh` — a different tree
# from the repo-root `scripts/` above, so the glob is spelled out rather than
# shared. Nothing ran them before this: `vault-set-section_test.sh` covered the
# section splice but was invoked only by hand, and CHANGELOG v0.19.1 recorded
# that gap. A helper whose exit code lies stays broken until something executes
# it, which is what the process-level case in that suite exists to catch.
SHELL_SCRIPTS = $(wildcard agent/scripts/*_test.sh)

.PHONY: python-check
python-check:
	@if [ -n "$(PYTHON_SCRIPTS)" ]; then \
		python3 -c "import ast,sys; [ast.parse(open(f, encoding='utf-8').read(), f) for f in sys.argv[1:]]" $(PYTHON_SCRIPTS) \
			&& echo "python-check: $(words $(PYTHON_SCRIPTS)) vendored script(s) parse"; \
	else \
		echo "python-check: no scripts/ to check"; \
	fi

# `python-check` only parses the scripts; it never runs them. The credential
# helper's contract -- the git credential-helper protocol, the base64 key
# decoding, the JWT bounds and every failure exit code -- is only proven by
# executing it, so the suite rides the same gate rather than a separate CI job.
# PYTHONDONTWRITEBYTECODE for the same reason `python-check` uses `ast.parse`
# instead of `py_compile`: importing the module under test otherwise drops a
# `scripts/__pycache__` into the tree, which .gitignore does not cover.
.PHONY: python-test
python-test:
	@PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts -t scripts -p '*_test.py' -v

.PHONY: shell-test
shell-test:
	@if [ -n "$(SHELL_SCRIPTS)" ]; then \
		for f in $(SHELL_SCRIPTS); do \
			echo "shell-test: $$f"; \
			bash "$$f" || exit 1; \
		done; \
	else \
		echo "shell-test: no agent/scripts/*_test.sh to run"; \
	fi

ensure:
	go mod tidy
	go mod verify
	rm -rf vendor

format:
	find . -type f -name 'go.mod' -not -path './vendor/*' -exec go run github.com/shoenig/go-modtool@$(GO_MODTOOL_VERSION) -w fmt "{}" \;
	go run github.com/incu6us/goimports-reviser/v3@$(GOIMPORTS_REVISER_VERSION) -project-name github.com/bborbe/agent-claude -format -excludes vendor ./...
	find . -type d -name vendor -prune -o -type f -name '*.go' -print0 | xargs -0 -n 10 go run github.com/segmentio/golines@$(GOLINES_VERSION) --max-len=100 -w
	find . -type f -name '*.go' -not -path './vendor/*' -exec gofmt -w "{}" +

generate:
	rm -rf mocks avro
	mkdir -p mocks
	echo "package mocks" > mocks/mocks.go
	go generate -mod=mod ./...

.PHONY: generatek8s
generatek8s:
	bash hack/update-codegen.sh

# -race=true catches data races but flakes on some CI runners (rare SIGSEGV
# during gexec.Build in cmd/*-style binary smoke tests). Default off; opt in
# via ENABLE_RACE=true for nightly/manual hardening runs.
TESTFLAGS_RACE = -race=false
ifdef ENABLE_RACE
	TESTFLAGS_RACE = -race=true
endif

.PHONY: test
test:
	go test -mod=mod -p=$${GO_TEST_PARALLEL:-1} -cover $(TESTFLAGS_RACE) $(shell go list -mod=mod ./... | grep -v /vendor/)

check: lint vet vulncheck osv-scanner trivy

lint:
	go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_LINT_VERSION) run --allow-parallel-runners --config .golangci.yml ./...

vet:
	go vet -mod=mod $(shell go list -mod=mod ./... | grep -v /vendor/)

# NOTE: no standalone `errcheck:` or `gosec:` target, and neither appears in the
# `check:` list above — golangci-lint runs both. A standalone target dies on Go
# 1.27.2 export data (version 5 > the maximum v1.20.0 errcheck can read), while
# golangci-lint >= v2.14.0 bundles an errcheck that can. See
# ~/Documents/workspaces/coding/docs/go-tools-versioning-guide.md.
# The exclusions those targets carried are still applied: `-ignore '(Close|Write|Fprint)'`
# by the `std-error-handling` preset in .golangci.yml's `exclusions.presets`, and
# `-exclude=G104` is moot because no unchecked-error finding exists for gosec to raise.

# The ignore set is now a SINGLE advisory. This block previously carried 20 ids
# covering the Go 1.27.1 stdlib, with an exit condition of "drop these once go.mod
# moves past 1.27.1". That condition fired: `go.mod` and the `Dockerfile` build
# stage now sit on 1.27.3, which retires all of them except GO-2026-5932.
#
# GO-2026-5932 survives because it is a LIBRARY advisory, not a stdlib one —
# `golang.org/x/crypto`'s openpgp package is unmaintained and unsafe by design —
# so a toolchain bump does not move it. Verified on 1.27.3 with
# `VULNCHECK_IGNORE= make vulncheck`, which reports that id and nothing else.
#
# Pruning in the other direction is equally deliberate: suppressing an advisory
# that is not firing would hide a finding that later becomes real, so ids are
# listed individually rather than as a range.
VULNCHECK_IGNORE ?= GO-2026-5932

.PHONY: vulncheck
vulncheck:
	@PKGS="$(shell go list -mod=mod ./... | grep -v /vendor/)"; \
	IGNORE_JSON=$$(printf '%s\n' $(VULNCHECK_IGNORE) | jq -R . | jq -s .); \
	REMAIN=$$(go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) -format json $$PKGS 2>/dev/null | \
		jq -rs --argjson ignore "$$IGNORE_JSON" \
			'(map(select(.osv != null)) | map({key: .osv.id, value: (.osv.summary // "")}) | from_entries) as $$sum | \
			 map(select(.finding != null) | .finding) | \
			 map(select(.osv as $$o | $$ignore | index($$o) | not)) | \
			 map("\(.osv)\t\(.trace[-1].module)@\(.trace[-1].version) -> \(.fixed_version)\t\($$sum[.osv] // "")") | \
			 unique | .[]'); \
	if [ -n "$$REMAIN" ]; then \
		echo "Unexpected vulnerabilities (ignored: $(VULNCHECK_IGNORE)):"; \
		printf '%s\n' "$$REMAIN" | column -t -s "$$(printf '\t')"; \
		exit 1; \
	else \
		echo "No unignored vulnerabilities found"; \
	fi

osv-scanner:
	@if [ -f .osv-scanner.toml ]; then \
		echo "Using .osv-scanner.toml"; \
		go run github.com/google/osv-scanner/v2/cmd/osv-scanner@$(OSV_SCANNER_VERSION) --config .osv-scanner.toml --recursive .; \
	else \
		echo "No config found, running default scan"; \
		go run github.com/google/osv-scanner/v2/cmd/osv-scanner@$(OSV_SCANNER_VERSION) --recursive .; \
	fi

.PHONY: trivy
trivy:
	trivy fs \
	--db-repository ghcr.io/aquasecurity/trivy-db \
	$(if $(wildcard .trivyignore),--ignorefile .trivyignore,$(if $(wildcard $(ROOTDIR)/.trivyignore),--ignorefile $(ROOTDIR)/.trivyignore,)) \
	$(if $(wildcard .trivy-secret.yaml),--secret-config .trivy-secret.yaml,$(if $(wildcard $(ROOTDIR)/.trivy-secret.yaml),--secret-config $(ROOTDIR)/.trivy-secret.yaml,)) \
	--scanners vuln,secret \
	--skip-dirs vendor \
	--quiet \
	--no-progress \
	--disable-telemetry \
	--exit-code 1 .

addlicense:
	go run github.com/google/addlicense@$(ADDLICENSE_VERSION) -c "Benjamin Borbe" -y $$(date +'%Y') -l bsd $$(find . -name "*.go" -not -path './vendor/*')
