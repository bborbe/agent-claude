DIRS += $(shell find */* -maxdepth 0 -name Makefile -exec dirname "{}" \;)

# Which machine builds the image. `local` builds here with the docker-driver
# builder; any other value is a cluster alias (sun, nukedev, nukeprod) or a raw
# kubectl context name, and the build runs as a Job there.
BUILD_TARGET ?= local

# Cluster-build inputs. The vendored cluster script defaults the namespace,
# timeout and Dockerfile and requires the push secret; the clone URL, tag and image
# come from this repository. They are declared here so an operator can override one
# without editing the script.
#
# ⚠️ The NAMESPACE is deliberately NOT one of them, and that is a correctness fix
# rather than an omission. The vendored Job manifest hardcodes `namespace: build`,
# while build-cluster.sh polls whatever namespace it is handed — so an override
# creates the Job in `build` and then polls elsewhere until the 3600 s deadline
# expires, which reads as a hung build rather than as the mistake it is. Until the
# manifest is templated upstream in bborbe/go-skeleton, the namespace is fixed at
# `build` and the script's own default is used. See the spec's Constraints.
BUILD_TIMEOUT ?= 3600
BUILD_REPO_URL ?= https://github.com/$(IMAGE).git
BUILD_DOCKERFILE ?= Dockerfile
BUILD_PUSH_SECRET ?= buildkit-push

# The branch or tag the cluster clones. Empty on purpose: the cluster arm must be
# told which commit to build, and the vendored script refuses to run without it.
REF ?=

# The build clock comes from the commit, not the wall clock, so two builds of one
# commit agree. BuildKit reads SOURCE_DATE_EPOCH when it rewrites file timestamps.
SOURCE_DATE_EPOCH ?= $(shell git log -1 --format=%ct)
BUILD_DATE ?= $(shell git log -1 --format=%cI)

# ⚠️ The prerequisites are LOCAL-ARM ONLY, and that is load-bearing rather than
# tidiness. `check-version-tag` asserts the tree sits at the tag it claims to build,
# and `check-go-mod` runs `go mod vendor` — both describe the local HEAD. The cluster
# arm builds REF, which need not be HEAD and need not exist locally at all, so running
# them there would validate a different commit than the one built, and would demand a
# local Go toolchain and network for a build that happens in the cluster.
.PHONY: build
ifeq ($(BUILD_TARGET),local)
build: check-version-tag check-go-mod
	@if [ -z "$(VERSION)" ]; then echo "ERROR: no VERSION set and no git tag found — set VERSION=vX.Y.Z or create a tag" >&2; exit 1; fi
	docker buildx build \
	--platform=linux/amd64 \
	--no-cache \
	--provenance=false \
	--sbom=false \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BUILD_GIT_VERSION=$$(git describe --tags --always --dirty) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$(BUILD_DATE) \
	--build-arg SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH) \
	-t $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION) \
	-f Dockerfile . \
	--output type=docker,rewrite-timestamp=true,unpack=false
else
build:
	BUILD_TARGET='$(BUILD_TARGET)' \
	TIMEOUT='$(BUILD_TIMEOUT)' \
	REPO_URL='$(BUILD_REPO_URL)' \
	REF='$(REF)' \
	TAG='$(VERSION)' \
	DOCKERFILE='$(BUILD_DOCKERFILE)' \
	IMAGE='$(DOCKER_REGISTRY)/$(IMAGE)' \
	PUSH='true' \
	PUSH_SECRET='$(BUILD_PUSH_SECRET)' \
	hack/build-cluster.sh
endif

.PHONY: check-version-tag
check-version-tag:
	@if [ -n "$(ALLOW_UNTAGGED_BUILD)" ]; then \
		echo "ALLOW_UNTAGGED_BUILD set — skipping version/tag check"; \
	else \
		head_tag=$$(git describe --tags --exact-match HEAD 2>/dev/null); \
		if [ "$$head_tag" != "$(VERSION)" ]; then \
			echo "ERROR: refusing to build $(VERSION) from this tree." >&2; \
			echo "  HEAD is at tag: $${head_tag:-<untagged>}" >&2; \
			echo "  building as:    $(VERSION)" >&2; \
			echo "  An image stamped vX.Y.Z must be built from the vX.Y.Z tag." >&2; \
			echo "  Fix: git checkout $(VERSION)   (or set ALLOW_UNTAGGED_BUILD=1 for a scratch build)" >&2; \
			exit 1; \
		fi; \
	fi

.PHONY: check-go-mod
check-go-mod:
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi

.PHONY: upload
upload:
ifeq ($(BUILD_TARGET),local)
	docker push $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)
else
	@echo "upload: skipped — BUILD_TARGET=$(BUILD_TARGET); the cluster Job already pushed $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)"
endif

.PHONY: clean
clean:
ifeq ($(BUILD_TARGET),local)
	docker rmi $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION) || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor
else
	@echo "clean: skipped — BUILD_TARGET=$(BUILD_TARGET); no local image to remove"
endif

.PHONY: apply
apply:
	@for i in $(DIRS); do \
		cd $$i; \
		echo "apply $${i}"; \
		make apply; \
		cd ..; \
	done

# Operator-run publish to Docker Hub (requires `docker login`). CI runs
# `make precommit`, never `buca`, so the unconditional push is safe. `apply` is a
# no-op placeholder (no k8s in this repo — deployment lives in the quant config
# repo as mirror + keel-pattern). Shape mirrors bborbe/kafka-topic-reader.
.PHONY: buca
buca: build upload clean apply
